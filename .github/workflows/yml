name: Android Build BiliPink

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]

env:
  PYTHONFORANDROID_PREREQUISITES_INSTALL_INTERACTIVE: 0

jobs:
  build-apk:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout source code
        uses: actions/checkout@v7

      - name: Setup Python 3.11
        uses: actions/setup-python@v7
        with:
          python-version: '3.11'

      - name: Setup Java 17 (Temurin)
        uses: actions/setup-java@v6
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Install system dependencies for buildozer/p4a
        run: |
          sudo apt update
          sudo apt -y install automake libltdl-dev zip unzip openjdk-17-jdk

      - name: Install python packages
        run: |
          python -m pip install --upgrade pip
          pip install buildozer==1.5.0

      - name: Show buildozer version
        run: buildozer --version

      # 我们仓库已经存在 buildozer.spec，不要执行 buildozer init！
      - name: Debug build APK
        run: |
          buildozer android debug

      - name: Upload debug APK artifact
        uses: actions/upload-artifact@v4
        with:
          name: bilipink-debug-apk
          path: bin/*.apk
